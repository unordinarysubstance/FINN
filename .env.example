# FINN loads .env on startup. Exported environment variables take precedence.
# Paste your OpenAI API key after the equals sign in your local .env.
OPENAI_API_KEY=
FINN_MODEL=gpt-4o-mini
# Keep FINN local until authentication is implemented.
# Optional runtime data directory; defaults to ./data.
# FINN_DATA_DIR=/absolute/path/to/private-data
# Set to 1 for tests/CLI diagnostics that must not start the scheduler.
# FINN_DISABLE_MONITOR=1

# Optional separate evidence reviewer. Defaults to FINN_MODEL.
# FINN_REVIEW_MODEL=gpt-6.1-sol
# FINN_REVIEW_EFFORT=low
# Optional official-company announcement source config (JSON); default examples/announcement_sources.json.
# FINN_ANNOUNCEMENT_SOURCES=/absolute/path/to/announcement_sources.json
