# FINN loads .env on startup. Exported environment variables take precedence.
# Create a key in Google AI Studio on a free-tier project without billing.
# Paste it only in your local .env or Render's secret environment, never in Git.
FINN_AI_PROVIDER=gemini
GEMINI_API_KEY=
FINN_GEMINI_MODEL=gemini-3.6-flash
# Per-pass timeout (10-180 seconds); both research passes default to 120.
FINN_GEMINI_TIMEOUT_SECONDS=120
# Space model requests for the observed free-tier 5 requests/minute limit.
FINN_GEMINI_REQUEST_INTERVAL_SECONDS=15
# Optional reviewer override; otherwise both passes use FINN_GEMINI_MODEL.
# FINN_GEMINI_REVIEW_MODEL=gemini-3.6-flash
# Gemini quota failures return evidence; there is no paid-provider fallback.
# Optional shared-demo HTTP Basic gate. Hosted credentials belong in the host's secret environment.
# FINN_REQUIRE_ACCESS=1
# FINN_ACCESS_USER=finn
# FINN_ACCESS_PASSWORD=
# Optional runtime data directory; defaults to ./data.
# FINN_DATA_DIR=/absolute/path/to/private-data
# Set to 1 for tests/CLI diagnostics that must not start the scheduler.
# FINN_DISABLE_MONITOR=1

# Legacy OpenAI support requires an explicit FINN_AI_PROVIDER=openai selection.
# OPENAI_API_KEY=
# FINN_MODEL=gpt-4o-mini
# FINN_REVIEW_MODEL=gpt-6.1-sol
# FINN_REVIEW_EFFORT=low
# Optional official-company announcement source config (JSON); default examples/announcement_sources.json.
# FINN_ANNOUNCEMENT_SOURCES=/absolute/path/to/announcement_sources.json

# Free-hosting reset notice; leave unset for ordinary local development.
# FINN_EPHEMERAL_DEMO=1
